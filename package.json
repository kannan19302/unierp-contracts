{
  "name": "@kannan19302/contracts",
  "version": "1.0.4",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "L0 — single source of truth for UniERP API contracts, event schemas, and entity types",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "check:control-centers": "npm run build && node scripts/check-control-center-catalog.mjs",
    "check:control-center-contracts": "npm run build && node scripts/check-control-center-contract-release.mjs",
    "check:control-center-manifests": "npm run build && node scripts/check-control-center-manifests.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "2.1.9"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "dependencies": {
    "zod": "^3.24.0"
  }
}
